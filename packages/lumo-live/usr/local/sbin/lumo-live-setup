#!/bin/sh
# lumo-live-setup - prepares the live session (runs once, as root).
# Triggered by the graphical.target wants symlink AND the display-manager
# ExecStartPre hook; fully idempotent. No-op on installed systems.
#
# NOTE: deliberately NO `set -e` - a failing probe (e.g. `[ -d x ] && ...`)
# must never abort this script: as an ExecStartPre it would take the whole
# display manager down with it.
set -u

# live session detection that cannot lie: our own kernel command line
case "$(cat /proc/cmdline 2>/dev/null)" in
  *boot=live*) : ;;
  *) exit 0 ;;
esac

# everything this script prints must be visible on the boot console
exec > /dev/console 2>&1
echo "[lumo-live] configuring live session"

# 1) live user (passwordless sudo - it is a live session)
if ! id lumo >/dev/null 2>&1; then
    useradd -m -c "Lumo Live User" -s /bin/bash lumo \
        || echo "[lumo-live] WARN: useradd failed"
fi
# add groups individually - a missing optional group must not break the user
for grp in sudo audio video input netdev users cdrom lp lpadmin bluetooth; do
    if getent group "$grp" >/dev/null 2>&1; then
        usermod -aG "$grp" lumo 2>/dev/null || true
    fi
done
cat > /etc/sudoers.d/90-lumo-live <<'EOF'
lumo ALL=(ALL) NOPASSWD: ALL
EOF
chmod 440 /etc/sudoers.d/90-lumo-live
if id lumo >/dev/null 2>&1; then
    echo "[lumo-live] user lumo ready ($(id -nG lumo | tr ' ' ','))"
else
    echo "[lumo-live] ERROR: user lumo missing!"
fi

# 2) SDDM autologin into the Lumo session
# NOTE: SDDM matches Session by the .desktop key WITH extension.
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/zz-live-autologin.conf <<'EOF'
[Autologin]
User=lumo
Session=lumo.desktop
Relogin=true
EOF

# 3) automated test mode: root shell on the serial console + SSH with an
#    ephemeral key from the kernel command line (never stored in the image).
if grep -q 'lumo.test=1' /proc/cmdline; then
    echo "[lumo-live] test mode requested"
    echo 'lumo:lumo' | chpasswd || echo "[lumo-live] WARN: chpasswd failed"
    mkdir -p /etc/systemd/system/serial-getty@ttyS0.service.d
    cat > /etc/systemd/system/serial-getty@ttyS0.service.d/autologin.conf <<'EOF'
[Service]
ExecStart=
ExecStart=-/sbin/agetty -a root -L -8 ttyS0 115200 vt100
Restart=always
EOF
    systemctl daemon-reload 2>/dev/null || true
    systemctl restart serial-getty@ttyS0.service 2>/dev/null || true
    PUBKEY="$(sed -n 's/.*lumo.pubkey=\([^ ]*\).*/\1/p' /proc/cmdline | base64 -d 2>/dev/null || true)"
    if [ -n "${PUBKEY:-}" ]; then
        install -d -m 700 -o lumo -g lumo /home/lumo/.ssh
        printf '%s\n' "$PUBKEY" > /home/lumo/.ssh/authorized_keys
        chown lumo:lumo /home/lumo/.ssh/authorized_keys
        chmod 600 /home/lumo/.ssh/authorized_keys
        echo "[lumo-live] ephemeral SSH key installed"
    fi
    systemctl enable --now ssh >/dev/null 2>&1 || systemctl restart ssh 2>/dev/null || true
    touch /run/lumo-test-mode
fi

echo "[lumo-live] ready"
exit 0
