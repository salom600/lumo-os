[Unit]
Description=Lumo OS live session bootstrap
Documentation=https://github.com/salom600/lumo-os
Before=display-manager.service
After=systemd-user-sessions.service

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/lumo-live-setup
RemainAfterExit=yes
StandardOutput=journal+console
StandardError=journal+console

[Install]
WantedBy=graphical.target
