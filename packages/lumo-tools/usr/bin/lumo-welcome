#!/bin/sh
# Lumo launcher wrapper.
# GTK4 cairo renderer: the GL renderer segfaults via llvmpipe on
# GPU-less machines (VMs, 2007-era hardware).
GSK_RENDERER=cairo
export GSK_RENDERER
# GTK 4.18: the accessibility (AT-SPI) context machinery has an infinite
# recursion crash (stack overflow in libgtk-4) with list/selection widgets
# when no a11y bus is present. GTK itself recommends GTK_A11Y=none here.
# Screen-reader users: set GTK_A11Y=atk-bridge to re-enable a11y.
GTK_A11Y=none
export GTK_A11Y
NO_AT_BRIDGE=1
export NO_AT_BRIDGE
# gtk4-layer-shell MUST be in the link map before libwayland-client, or layer
# surface init silently fails ("may have been linked after libwayland").
# Python/GI has no link-time ordering, so we preload it explicitly.
LS=/usr/lib/x86_64-linux-gnu/libgtk4-layer-shell.so.0
if [ ! -f "$LS" ]; then
    LS=$(ls /usr/lib/*/libgtk4-layer-shell.so.0* 2>/dev/null | head -n1)
fi
if [ -n "$LS" ] && [ -f "$LS" ]; then
    case ":${LD_PRELOAD:-}:" in
        *":$LS:"*) ;;  # already preloaded
        *) LD_PRELOAD="$LS${LD_PRELOAD:+:$LD_PRELOAD}"; export LD_PRELOAD ;;
    esac
fi
exec /usr/libexec/lumo/lumo-welcome "$@"
