#!/usr/bin/python3
"""Lumo Quick Settings - top-right control center panel.

Real backends:
  Wi-Fi      : nmcli (radio + current connection)
  Bluetooth  : bluetoothctl power (rfkill fallback via pkexec)
  Game Mode  : pkexec /usr/bin/lumo-perf toggle (polkit-gated)
  Appearance : /usr/bin/lumo-appearance dark|light
  Volume     : pactl
  Brightness : brightnessctl (hidden when no backlight)
  Battery    : sysfs
The process exits after use to keep idle RAM minimal.
"""
import os
import subprocess
import sys
import threading

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import GLib, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

sys.path.insert(0, "/usr/lib/python3/dist-packages")
from lumo import style  # noqa: E402


def run(cmd, timeout=6):
    """Run command, return stdout or None on failure."""
    try:
        out = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return out.stdout if out.returncode == 0 else None
    except Exception:
        return None


class QSTile(Gtk.Button):
    """A Quick Settings toggle tile."""

    def __init__(self, app, title, subtitle, icon):
        super().__init__()
        self.app = app
        self.set_has_frame(True)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        img = Gtk.Image.new_from_icon_name(icon)
        img.set_pixel_size(20)
        box.append(img)
        vb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=1)
        t = Gtk.Label(label=title, halign=Gtk.Align.START)
        t.add_css_class("lumo-heading")
        self.sub = Gtk.Label(label=subtitle, halign=Gtk.Align.START)
        self.sub.add_css_class("lumo-dim")
        vb.append(t)
        vb.append(self.sub)
        box.append(vb)
        self.set_child(box)
        self.set_hexpand(True)
        self.add_css_class("lumo-tile")


class QuickSettings(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.lumo.QS")
        self.win = None
        self.updating = False

    def do_activate(self):
        self.win = Gtk.ApplicationWindow(application=self, decorated=False)
        win = self.win
        style.apply_to_display()
        try:
            LayerShell.init_for_window(win)
            LayerShell.set_layer(win, LayerShell.Layer.TOP)
            LayerShell.set_anchor(win, LayerShell.Edge.TOP, True)
            LayerShell.set_anchor(win, LayerShell.Edge.RIGHT, True)
            LayerShell.set_margin(win, LayerShell.Edge.TOP, 46)
            LayerShell.set_margin(win, LayerShell.Edge.RIGHT, 10)
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)
        except Exception as exc:
            print(f"[lumo-qs] layer-shell unavailable ({exc}); running as window")

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        panel.set_size_request(400, -1)
        panel.add_css_class("lumo-glass")

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL)
        title = Gtk.Label(label="Quick Settings", halign=Gtk.Align.START, hexpand=True)
        title.add_css_class("lumo-title")
        header.append(title)
        close = Gtk.Button(icon_name="window-close-symbolic")
        close.add_css_class("lumo-round")
        close.connect("clicked", lambda *_: self.quit())
        header.append(close)
        panel.append(header)

        # ---- toggle tiles (2x2) ----
        grid = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, homogeneous=True)
        col1 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, homogeneous=True)
        col2 = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10, homogeneous=True)

        self.wifi = QSTile(self, "Wi-Fi", "…", "network-wireless-symbolic")
        self.wifi.connect("clicked", lambda *_: self.toggle_wifi())
        col1.append(self.wifi)

        self.bt = QSTile(self, "Bluetooth", "…", "bluetooth-active-symbolic")
        self.bt.connect("clicked", lambda *_: self.toggle_bt())
        col2.append(self.bt)

        self.gm = QSTile(self, "Game Mode", "performance profile", "applications-games-symbolic")
        self.gm.connect("clicked", lambda *_: self.toggle_gamemode())
        col1.append(self.gm)

        self.dark = QSTile(self, "Dark Mode", "appearance", "weather-clear-night-symbolic")
        self.dark.connect("clicked", lambda *_: self.toggle_dark())
        col2.append(self.dark)

        grid.append(col1)
        grid.append(col2)
        panel.append(grid)

        # ---- volume ----
        self.vol_row = self._slider_row(
            "audio-volume-high-symbolic", 0, 100, 1,
            lambda adj: run(["pactl", "set-sink-volume", "@DEFAULT_SINK@",
                             f"{int(adj.get_value())}%"]))
        panel.append(self.vol_row)

        # ---- brightness (auto-hidden when unsupported) ----
        self.bri_row = self._slider_row(
            "display-brightness-symbolic", 0, 100, 1,
            lambda adj: run(["brightnessctl", "set", f"{int(adj.get_value())}%"]))
        panel.append(self.bri_row)

        # ---- battery row ----
        self.bat_row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        self.bat_row.add_css_class("lumo-row")
        self.bat_icon = Gtk.Image.new_from_icon_name("battery-full-symbolic")
        self.bat_label = Gtk.Label(label="Battery", halign=Gtk.Align.START, hexpand=True)
        self.bat_row.append(self.bat_icon)
        self.bat_row.append(self.bat_label)
        panel.append(self.bat_row)

        # ---- bottom actions ----
        actions = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8, homogeneous=True)
        for icon, tip, cmd in (
            ("settings-symbolic", "Settings", "lumo-settings"),
            ("system-software-install-symbolic", "Lumo Store", "lumo-store"),
            ("camera-photo-symbolic", "Screenshot (region)", "lumo-screenshot region"),
            ("system-lock-screen-symbolic", "Lock", "/usr/libexec/lumo/lumo-lock"),
            ("system-shutdown-symbolic", "Power", "lumo-power"),
        ):
            b = Gtk.Button(icon_name=icon)
            b.add_css_class("lumo-round")
            b.set_tooltip_text(tip)
            b.connect("clicked", self._spawn_and_close, cmd)
            actions.append(b)
        panel.append(actions)

        esc = Gtk.EventControllerKey()
        esc.connect("key-pressed", self._on_key)
        win.add_controller(esc)

        win.set_child(panel)
        win.present()
        self.refresh_states_async()

    # ---------- helpers ----------
    def _slider_row(self, icon, lo, hi, step, on_change):
        row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        row.add_css_class("lumo-row")
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        img = Gtk.Image.new_from_icon_name(icon)
        top.append(img)
        label = Gtk.Label(label="", halign=Gtk.Align.START, hexpand=True)
        top.append(label)
        row.append(top)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, lo, hi, step)
        scale.set_draw_value(False)
        adj = scale.get_adjustment()
        label_txt = label

        def changed(adj):
            label_txt.set_text(f"{int(adj.get_value())}%")
            on_change(adj)
        scale.connect("value-changed", changed)
        row._scale = scale
        row._label = label
        return row

    def _on_key(self, _c, keyval, _kc, _m):
        if keyval == 65307:
            self.quit()
            return True
        return False

    def _spawn_and_close(self, _b, cmd):
        import shlex
        try:
            subprocess.Popen(shlex.split(cmd), start_new_session=True)
        except Exception:
            pass
        self.quit()

    def set_tile(self, tile, on, sub):
        tile.sub.set_text(sub)
        if on:
            tile.add_css_class("lumo-tile-on")
        else:
            tile.remove_css_class("lumo-tile-on")

    # ---------- state refresh ----------
    def refresh_states_async(self):
        def worker():
            data = {}
            data["wifi_on"] = run(["nmcli", "radio", "wifi"])
            data["wifi_conn"] = run(["bash", "-c",
                "nmcli -t -f NAME,TYPE,DEVICE connection show --active | grep -v ':loopback' | head -n1"])
            data["bt"] = run(["bluetoothctl", "show"])
            data["gm"] = run(["pkexec", "/usr/bin/lumo-perf", "status"], timeout=15)
            data["vol"] = run(["bash", "-c",
                "pactl get-sink-volume @DEFAULT_SINK@ | head -n1 | grep -oE '[0-9]+%' | head -n1"])
            data["bri"] = run(["bash", "-c", "brightnessctl info -m | tail -n1"])
            data["bat"] = run(["bash", "-c",
                "cat /sys/class/power_supply/BAT*/capacity 2>/dev/null | head -n1"])
            data["bats"] = run(["bash", "-c",
                "cat /sys/class/power_supply/BAT*/status 2>/dev/null | head -n1"])
            GLib.idle_add(self.apply_states, data)
        threading.Thread(target=worker, daemon=True).start()

    def apply_states(self, data):
        wifi_on = bool(data.get("wifi_on") and data["wifi_on"].strip().lower() == "enabled")
        wifi_sub = "off"
        if data.get("wifi_conn"):
            name = data["wifi_conn"].split(":")[0]
            if name:
                wifi_sub = name if wifi_on else wifi_sub
        if wifi_on and wifi_sub == "off":
            wifi_sub = "on - not connected"
        self.set_tile(self.wifi, wifi_on, wifi_sub)

        bt_out = data.get("bt") or ""
        bt_on = "Powered: yes" in bt_out
        self.set_tile(self.bt, bt_on, "on" if bt_on else "off")

        gm_on = bool(data.get("gm") and data["gm"].strip() == "on")
        self.set_tile(self.gm, gm_on, "performance" if gm_on else "balanced")

        dark = style.is_dark()
        self.set_tile(self.dark, dark, "dark" if dark else "light")

        try:
            vol = int((data.get("vol") or "50%").replace("%", ""))
        except ValueError:
            vol = 50
        self.vol_row._scale.set_value(vol)

        bri_line = data.get("bri") or ""
        if "," in bri_line:
            parts = bri_line.split(",")
            try:
                cur, mx = int(parts[3]), int(parts[4])
                self.bri_row._scale.set_value(int(cur * 100 / mx))
            except (IndexError, ValueError, ZeroDivisionError):
                self.win.remove(self.bri_row)
        else:
            self.win.remove(self.bri_row)

        bat = (data.get("bat") or "").strip()
        if bat:
            try:
                pct = int(bat)
                status = (data.get("bats") or "").strip()
                icon = "battery-full-charging-symbolic" if status == "Charging" else "battery-full-symbolic"
                if pct < 20:
                    icon = "battery-empty-symbolic"
                elif pct < 55:
                    icon = "battery-good-symbolic"
                self.bat_icon.set_from_icon_name(icon)
                self.bat_label.set_text(f"Battery - {pct}%{' (charging)' if status == 'Charging' else ''}")
            except ValueError:
                self.win.remove(self.bat_row)
        else:
            self.win.remove(self.bat_row)
        return False

    # ---------- toggles ----------
    def toggle_wifi(self):
        def worker():
            on = run(["nmcli", "radio", "wifi"])
            cur = bool(on and on.strip().lower() == "enabled")
            run(["nmcli", "radio", "wifi", "off" if cur else "on"])
            GLib.idle_add(self.refresh_states_async)
        threading.Thread(target=worker, daemon=True).start()

    def toggle_bt(self):
        def worker():
            out = run(["bluetoothctl", "show"]) or ""
            if "Powered: yes" in out:
                run(["bluetoothctl", "power", "off"])
            else:
                res = run(["bluetoothctl", "power", "on"])
                if res is None or "succeeded" not in res.lower():
                    run(["pkexec", "rfkill", "unblock", "bluetooth"])
            GLib.idle_add(self.refresh_states_async)
        threading.Thread(target=worker, daemon=True).start()

    def toggle_gamemode(self):
        def worker():
            run(["pkexec", "/usr/bin/lumo-perf", "toggle"], timeout=30)
            GLib.idle_add(self.refresh_states_async)
        threading.Thread(target=worker, daemon=True).start()

    def toggle_dark(self):
        target = "light" if style.is_dark() else "dark"
        run(["/usr/bin/lumo-appearance", target])
        style._dark = None  # force re-read
        GLib.idle_add(self.refresh_states_async)


if __name__ == "__main__":
    QuickSettings().run(sys.argv)
