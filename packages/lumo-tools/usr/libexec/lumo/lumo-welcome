#!/usr/bin/python3
"""Lumo Welcome - first-run helper window.

Shows distro identity and quick actions. The Install button only appears
when Calamares is present (live media). Everything is real: it spawns the
store, settings or the installer.
"""
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "4.0")
from gi.repository import Gtk  # noqa: E402

sys.path.insert(0, "/usr/lib/python3/dist-packages")
from lumo import style  # noqa: E402


class Welcome(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.lumo.Welcome")
        self.win = None

    def do_activate(self):
        self.win = Gtk.ApplicationWindow(application=self, decorated=False)
        win = self.win
        style.apply_to_display()
        win.set_default_size(560, 460)
        win.set_resizable(False)

        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=18)
        root.add_css_class("lumo-root")
        root.set_margin_top(30)
        root.set_margin_bottom(30)
        root.set_margin_start(36)
        root.set_margin_end(36)

        logo = Gtk.Image.new_from_file("/usr/share/icons/hicolor/scalable/apps/lumo-logo.svg")
        logo.set_pixel_size(88)
        root.append(logo)

        title = Gtk.Label(label="Welcome to Lumo OS")
        title.add_css_class("lumo-title")
        root.append(title)

        sub = Gtk.Label(
            label='Version 1.0 "Aurora" - a featherlight Debian 13 based desktop.\n'
                  "Ultra-light, gaming-friendly, beautiful. All your hardware, all day.")
        sub.add_css_class("lumo-subtitle")
        sub.set_justify(Gtk.Justification.CENTER)
        root.append(sub)

        grid = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        grid.set_valign(Gtk.Align.CENTER)
        grid.set_vexpand(True)

        if os.path.exists("/usr/bin/calamares"):
            install = Gtk.Button(label="Install Lumo OS")
            install.add_css_class("lumo-btn")
            install.connect("clicked", self._install)
            grid.append(install)

        row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10, homogeneous=True)
        store = Gtk.Button(label="Lumo Store")
        store.add_css_class("lumo-btn-flat")
        store.connect("clicked", lambda *_: self._spawn("lumo-store"))
        row.append(store)

        settings = Gtk.Button(label="Settings")
        settings.add_css_class("lumo-btn-flat")
        settings.connect("clicked", lambda *_: self._spawn("lumo-settings"))
        row.append(settings)
        grid.append(row)

        notes = Gtk.Button(label="Release Notes")
        notes.add_css_class("lumo-btn-flat")
        notes.connect("clicked", lambda *_: self._spawn(
            "firefox-esr https://github.com/salom600/lumo-os"))
        grid.append(notes)

        root.append(grid)

        close = Gtk.Button(label="Get Started")
        close.add_css_class("lumo-btn")
        close.connect("clicked", lambda *_: self.quit())
        root.append(close)

        esc = Gtk.EventControllerKey()
        esc.connect("key-pressed", self._on_key)
        win.add_controller(esc)

        win.set_child(root)
        win.present()

        # CI hook: present() maps layer surfaces SYNCHRONOUSLY, so the
        # 'map' signal may fire before connect() below - print directly.
        print("LUMO_MAP_OK", flush=True)

        def _lumo_map_mark(_w=None):
            print("LUMO_MAP_OK", flush=True)  # late-mapping safety net
            return False

        win.connect("map", _lumo_map_mark)

    def _install(self, _b):
        try:
            # polkit action com.lumo.installer.run allows the active session
            subprocess.Popen(["pkexec", "/usr/bin/calamares"], start_new_session=True)
        except Exception as exc:
            print(f"[lumo-welcome] {exc}")
        self.quit()

    def _spawn(self, cmd):
        import shlex
        try:
            subprocess.Popen(shlex.split(cmd), start_new_session=True)
        except Exception:
            pass

    def _on_key(self, _c, keyval, _kc, _m):
        if keyval == 65307:
            self.quit()
            return True
        return False


if __name__ == "__main__":
    Welcome().run(sys.argv)
