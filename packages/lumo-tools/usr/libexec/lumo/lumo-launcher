#!/usr/bin/python3
"""Lumo Launcher - glassy full-screen app launcher overlay (Win11-style panel).

Real behavior: lists every installed application, instant search filter,
launches via Gio.DesktopAppInfo. Exits after launch or Escape (light RAM).
"""
import os
import sys

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Gtk4LayerShell", "1.0")
from gi.repository import Gio, GLib, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

sys.path.insert(0, "/usr/lib/python3/dist-packages")
from lumo import style  # noqa: E402

EXCLUDED = {"lumo-launcher.desktop", "lumo-qs.desktop", "lumo-calendar.desktop",
            "lumo-power.desktop", "com.github.Calamares.calamares.desktop"}


def load_apps():
    apps = []
    for info in Gio.AppInfo.get_all():
        try:
            if not isinstance(info, Gio.DesktopAppInfo):
                continue
            if info.get_is_hidden() or info.get_nodisplay():
                continue
            if not info.should_show():
                continue
            did = info.get_id() or ""
            if did in EXCLUDED:
                continue
            apps.append(info)
        except Exception:
            continue

    def keyfn(a):
        return (a.get_display_name() or "").lower()

    apps.sort(key=keyfn)
    return apps


class Launcher(Gtk.Application):
    def __init__(self):
        super().__init__(application_id="org.lumo.Launcher")
        self.apps = []
        self.win = None

    def do_activate(self):
        self.win = Gtk.ApplicationWindow(application=self, decorated=False)
        win = self.win
        style.apply_to_display()

        try:
            LayerShell.init_for_window(win)
            LayerShell.set_layer(win, LayerShell.Layer.OVERLAY)
            for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM,
                         LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
                LayerShell.set_anchor(win, edge, True)
            LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.EXCLUSIVE)
        except Exception as exc:
            print(f"[lumo-launcher] layer-shell unavailable ({exc}); running as window")

        # root dim layer catches outside clicks
        root = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        root.add_css_class("lumo-overlay")
        click = Gtk.GestureClick()
        click.connect("released", self._on_outside)
        root.add_controller(click)

        overlay = Gtk.Overlay(vexpand=True, hexpand=True)
        overlay.set_child(root)

        panel = self._build_panel()
        overlay.add_overlay(panel)
        win.set_child(overlay)

        esc = Gtk.EventControllerKey()
        esc.connect("key-pressed", self._on_key)
        win.add_controller(esc)

        win.present()

        def _lumo_map_mark(_w=None):
            # CI hook: lets the test harness wait for the actual map event
            print("LUMO_MAP_OK", flush=True)
            return False

        win.connect("map", _lumo_map_mark)
        self.entry.grab_focus()

    # ---------- UI construction ----------
    def _build_panel(self):
        self.apps = load_apps()

        panel = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        panel.set_size_request(640, 560)
        panel.set_halign(Gtk.Align.CENTER)
        panel.set_valign(Gtk.Align.CENTER)
        panel.add_css_class("lumo-glass")
        panel.set_margin_top(80)

        header = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        title = Gtk.Label(label="Applications", halign=Gtk.Align.START, hexpand=True)
        title.add_css_class("lumo-title")
        header.append(title)

        power_btn = Gtk.Button(icon_name="system-shutdown-symbolic")
        power_btn.add_css_class("lumo-round")
        power_btn.set_tooltip_text("Power")
        power_btn.connect("clicked", lambda *_: self._spawn("lumo-power"))
        header.append(power_btn)

        close_btn = Gtk.Button(icon_name="window-close-symbolic")
        close_btn.add_css_class("lumo-round")
        close_btn.connect("clicked", lambda *_: self.quit())
        header.append(close_btn)
        panel.append(header)

        self.entry = Gtk.Entry()
        self.entry.set_placeholder_text("Search applications…")
        self.entry.add_css_class("lumo-entry")
        self.entry.connect("search-changed", lambda *_: self.flow.invalidate_filter())
        self.entry.connect("activate", self._on_activate_first)
        panel.append(self.entry)

        scrolled = Gtk.ScrolledWindow(vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        scrolled.set_child(self._build_flow())
        panel.append(scrolled)

        footer = Gtk.Label(label="Enter to launch first result · Esc to close")
        footer.add_css_class("lumo-dim")
        footer.set_halign(Gtk.Align.START)
        panel.append(footer)
        return panel

    def _build_flow(self):
        self.flow = Gtk.FlowBox(
            selection_mode=Gtk.SelectionMode.NONE,
            orientation=Gtk.Orientation.HORIZONTAL,
            max_children_per_line=5,
            min_children_per_line=4,
            column_spacing=6,
            row_spacing=6,
            vexpand=True,
        )
        self.flow.set_filter_func(self._filter)
        for app in self.apps:
            cell = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8,
                           halign=Gtk.Align.CENTER)
            cell.add_css_class("lumo-appcell")

            icon = Gtk.Image.new_from_gicon(self._icon(app))
            icon.set_pixel_size(48)
            cell.append(icon)

            name = Gtk.Label(label=app.get_display_name(), wrap=True, justify=Gtk.Justification.CENTER)
            name.set_size_request(104, -1)
            name.add_css_class("title")
            cell.append(name)

            btn = Gtk.Button()
            btn.set_child(cell)
            btn.add_css_class("flat")
            btn.set_has_frame(False)
            btn.connect("clicked", self._on_app, app)
            btn._lumo_app = app
            self.flow.append(btn)
        return self.flow

    # ---------- helpers ----------
    def _icon(self, app):
        icon = app.get_icon()
        if icon:
            return icon
        return Gio.ThemedIcon.new("application-x-executable")

    def _filter_text(self):
        return (self.entry.get_text() or "").strip().lower()

    def _filter(self, child):
        btn = child.get_child()
        app = getattr(btn, "_lumo_app", None)
        if app is None:
            return True
        text = self._filter_text()
        if not text:
            return True
        name = (app.get_display_name() or "").lower()
        generic = (app.get_generic_name() or "").lower()
        desc = (app.get_description() or "").lower()
        return text in name or text in generic or text in desc

    def _on_app(self, _btn, app):
        self._launch(app)

    def _launch(self, app):
        try:
            ctx = self.win.get_display().get_app_launch_context()
            app.launch([], ctx)
        except Exception as exc:
            print(f"[lumo-launcher] failed to launch: {exc}")
        GLib.idle_add(self.quit)

    def _on_activate_first(self, *_):
        for child in self.flow:
            if self._filter(child):
                btn = child.get_child()
                app = getattr(btn, "_lumo_app", None)
                if app:
                    self._launch(app)
                return

    def _on_key(self, _ctrl, keyval, _kc, _mod):
        if keyval == 65307:  # Escape
            self.quit()
            return True
        return False

    def _on_outside(self, _g, _n, _x, _y):
        # clicking the dim area (not the panel) closes the launcher
        self.quit()
        return False

    def _spawn(self, cmd):
        import subprocess
        try:
            subprocess.Popen([cmd], start_new_session=True)
        except Exception:
            pass
        self.quit()


if __name__ == "__main__":
    Launcher().run(sys.argv)
